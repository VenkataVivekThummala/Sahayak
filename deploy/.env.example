# Deployment Environment Configuration (.env)
DOMAIN=sahayak.yourdomain.org
APP_ENV=production

# Database Settings
POSTGRES_USER=sahayak
POSTGRES_PASSWORD=generate_a_very_strong_password_here_12345
POSTGRES_DB=sahayak_db

# Security
JWT_SECRET=generate_a_cryptographically_secure_jwt_secret_minimum_32_characters_here

# Services
RATE_LIMIT_PER_MINUTE=60
SIMILARITY_THRESHOLD=0.22
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
